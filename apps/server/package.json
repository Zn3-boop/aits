{
  "name": "@lpm/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate --schema=prisma/schema.prisma",
    "dev": "pnpm kill-port && node --env-file=../../.env ./node_modules/tsx/dist/cli.mjs watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/index.js",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma": "prisma",
    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "kill-port": "npx kill-port 8787 || true"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^1.38.5",
    "@fastify/cors": "^11.1.0",
    "@fastify/env": "^5.0.3",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.3",
    "@fastify/static": "^9.1.3",
    "@fastify/websocket": "^11.2.0",
    "@lpm/llm-core": "workspace:*",
    "@lpm/shared": "workspace:*",
    "@prisma/client": "^6.18.0",
    "@types/form-data": "^2.5.2",
    "axios": "^1.16.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "edge-tts": "^1.0.1",
    "express": "^5.2.1",
    "fastify": "^5.6.1",
    "form-data": "^4.0.5",
    "jsonwebtoken": "^9.0.3",
    "pino-pretty": "^13.1.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.12.2",
    "eslint": "^9.39.1",
    "prisma": "^6.18.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.8"
  }
}